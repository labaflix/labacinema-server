      { slug:'love-stories', name:'Love Stories',  desc:'Romantic tales' },
      { slug:'comedy',       name:'Comedy',        desc:'Laugh out loud' },
      { slug:'crime',        name:'Crime',         desc:'Dark mysteries' },
      { slug:'family',       name:'Family Movies', desc:'Fun for everyone' },
      { slug:'sci-fi',       name:'Sci-Fi',        desc:'Extraordinary worlds' },
      { slug:'romance',      name:'Romance',       desc:'Love & relationships' },
      { slug:'kung-fu',      name:'Kung Fu',       desc:'Martial arts mastery' },
      { slug:'drama',        name:'Drama',         desc:'Emotional stories' },
      { slug:'sport',        name:'Sport',         desc:'Athletic achievements' },
      { slug:'thriller',     name:'Thriller',      desc:'Edge-of-your-seat' },
      { slug:'animation',    name:'Animation',     desc:'Animated adventures' }
    ]; %>

