      { slug:'vj-eddy', name:'Vj Eddy' }, { slug:'vj-emmy', name:'Vj Emmy' },
      { slug:'vj-fredy', name:'Vj Fredy' }, { slug:'vj-ham', name:'Vj Ham' },
      { slug:'vj-hd', name:'Vj Hd' }, { slug:'vj-heavy-k', name:'Vj Heavy K' },
      { slug:'vj-heavy-q', name:'Vj Heavy Q' }, { slug:'vj-henrico', name:'Vj Henrico' },
      { slug:'vj-ice-p', name:'Vj Ice P' }, { slug:'vj-illness', name:'Vj Illness' },
