      { slug:'vj-narts', name:'Vj Narts' }, { slug:'vj-nasa', name:'Vj Nasa' },
      { slug:'vj-neil', name:'VJ Neil' }, { slug:'vj-nelly', name:'Vj Nelly' },
      { slug:'vj-o3', name:'Vj O3' }, { slug:'vj-pauleta', name:'Vj Pauleta' },
      { slug:'vj-pax', name:'Vj Pax' }, { slug:'vj-phoenix', name:'Vj Phoenix' },
      { slug:'vj-raj', name:'Vj Raj' }, { slug:'vj-raji', name:'Vj Raji' },
      { slug:'vj-rajiv', name:'Vj Rajiv' }, { slug:'vj-ricky', name:'Vj Ricky' },
      { slug:'vj-roddy', name:'Vj Roddy' }, { slug:'vj-ronage', name:'Vj Ronage' },
      { slug:'vj-ronnie', name:'Vj Ronnie' }, { slug:'vj-ryan', name:'VJ Ryan' },
      { slug:'vj-sahin', name:'Vj Sahin' }, { slug:'vj-sammy', name:'Vj Sammy' },
      { slug:'vj-sammy-lee', name:'Vj Sammy Lee' }, { slug:'vj-shao-khan', name:'Vj Shao Khan' },
      { slug:'vj-sharz', name:'Vj Sharz' }, { slug:'vj-shield', name:'VJ Shield' },
      { slug:'vj-shivo', name:'Vj Shivo' }, { slug:'vj-silver', name:'Vj Silver' },
      { slug:'vj-smk', name:'Vj Smk' }, { slug:'vj-son', name:'Vj Son' },
      { slug:'vj-son-k', name:'Vj Son K' }, { slug:'vj-soul', name:'Vj Soul' },
