      { slug:'vj-ivo', name:'Vj Ivo' }, { slug:'vj-j', name:'Vj J' },
      { slug:'vj-jabel', name:'Vj Jabel' }, { slug:'vj-jeff', name:'Vj Jeff' },
      { slug:'vj-jimmy', name:'Vj Jimmy' }, { slug:'vj-jingo', name:'Vj Jingo' },
      { slug:'vj-jona', name:'Vj Jona' }, { slug:'vj-jovan', name:'Vj Jovan' },
      { slug:'vj-julio', name:'Vj Julio' }, { slug:'vj-jumpers', name:'Vj Jumpers' },
      { slug:'vj-junior', name:'Vj Junior' }, { slug:'vj-kali', name:'Vj Kali' },
      { slug:'vj-kam', name:'Vj Kam' }, { slug:'vj-kamran', name:'Vj Kamran' },
      { slug:'vj-kan-man', name:'Vj Kan Man' }, { slug:'vj-karts', name:'Vj karts' },
      { slug:'vj-kats', name:'Vj Kats' }, { slug:'vj-kevin', name:'Vj Kevin' },
      { slug:'vj-kevo', name:'Vj Kevo' }, { slug:'vj-khan-li', name:'Vj Khan Li' },
      { slug:'vj-kimuli', name:'Vj Kimuli' }, { slug:'vj-kin', name:'Vj Kin' },
      { slug:'vj-kiwa', name:'Vj Kiwa' }, { slug:'vj-kk', name:'Vj Kk' },
      { slug:'vj-kress-s', name:'Vj Kress S' }, { slug:'vj-kriss-sweet', name:'Vj Kriss Sweet' },
      { slug:'vj-ks', name:'Vj KS' }, { slug:'vj-lance', name:'Vj Lance' },
      { slug:'vj-lash', name:'Vj Lash' }, { slug:'vj-light', name:'Vj Light' },
      { slug:'vj-little-t', name:'Vj Little T' }, { slug:'vj-luganda', name:'Vj Luganda' },
      { slug:'vj-madava', name:'Vj Madava' }, { slug:'vj-mangi', name:'Vj Mangi' },
      { slug:'vj-mark', name:'VJ Mark' }, { slug:'vj-martin-k', name:'Vj Martin K' },
      { slug:'vj-mk-kisule', name:'Vj MK Kisule' }, { slug:'vj-moon', name:'Vj Moon' },
