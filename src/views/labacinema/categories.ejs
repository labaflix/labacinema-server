      { slug:'vj-zaidi', name:'Vj Zaidi' }, { slug:'vj-zico-pro', name:'Vj Zico Pro' }
    ]; %>

    <section class="browse-panel active" data-panel="categories">
      <div class="browse-grid">
        <% genres.forEach(function(g){ %>
          <a class="browse-card" href="/movies?cat=<%= g.slug %>">
            <div class="browse-card-body">
              <h3 class="browse-card-title"><%= g.name %></h3>
              <p class="browse-card-desc"><%= g.desc %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="browse-panel" data-panel="vjs">
      <div class="vj-search-wrap">
        <input type="text" id="vjSearch" class="vj-search" placeholder="Search VJs...">
      </div>
      <div class="vj-grid" id="vjGrid">
        <% vjs.forEach(function(v){ %>
          <a class="vj-chip" href="/movies?vj=<%= v.slug %>" data-name="<%= v.name.toLowerCase() %>">
            <span class="vj-avatar"><%= v.name.replace(/^Vj\s+|^VJ\s+/i, '').charAt(0) %></span>
            <span class="vj-name"><%= v.name %></span>
          </a>
        <% }) %>
      </div>
      <p id="vjNoResults" class="vj-no-results" style="display:none;">No VJs match your search</p>
    </section>
  </main>

  <%- include('../shared/footer', { brand: brand }) %>

  <script>
    (function () {
      var tabs = document.querySelectorAll('.browse-tab');
      var panels = document.querySelectorAll('.browse-panel');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-tab');
          tabs.forEach(function (t) {
            t.classList.toggle('active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          panels.forEach(function (p) {
            p.classList.toggle('active', p.getAttribute('data-panel') === target);
          });
        });
      });

      // VJ search
      var search = document.getElementById('vjSearch');
      var grid = document.getElementById('vjGrid');
      var noResults = document.getElementById('vjNoResults');
      if (search && grid) {
        search.addEventListener('input', function () {
          var q = search.value.toLowerCase().trim();
          var visible = 0;
          grid.querySelectorAll('.vj-chip').forEach(function (chip) {
            var name = chip.getAttribute('data-name') || '';
            if (!q || name.indexOf(q) !== -1) {
              chip.style.display = '';
              visible++;
            } else {
              chip.style.display = 'none';
            }
          });
          if (noResults) noResults.style.display = (visible === 0 && q) ? 'block' : 'none';
        });
      }
    })();
  </script>
</body>
</html>
