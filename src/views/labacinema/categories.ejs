<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Categories &amp; VJs - <%= brand.name %><%= brand.suffix %></title>
  <link rel="stylesheet" href="/css/labacinema.css">
  <%- include('../shared/head-meta') %>
</head>
<body>
  <%- include('../shared/nav', { brand: brand, query: '', active: 'categories' }) %>

  <main class="browse-page">
    <header class="browse-header">
      <h1 class="browse-title">Discover Content</h1>
      <p class="browse-subtitle">Browse by genre or find movies by your favorite VJ</p>
    </header>

    <div class="browse-tabs" role="tablist">
      <button class="browse-tab active" data-tab="categories" role="tab" aria-selected="true">Categories</button>
      <button class="browse-tab" data-tab="vjs" role="tab" aria-selected="false">VJs</button>
    </div>

