              </svg>
            </span>
            <span class="nfh-contact-value">0702430965</span>
          </div>
          <span class="nfh-contact-arrow">→</span>
        </a>

        <a class="nfh-contact-row" href="https://t.me/labacinema" target="_blank" rel="noopener">
          <div class="nfh-contact-left">
            <span class="nfh-contact-logo" data-brand="telegram" aria-label="Telegram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/>
              </svg>
            </span>
            <span class="nfh-contact-value">@labacinema</span>
          </div>
          <span class="nfh-contact-arrow">→</span>
        </a>

        <a class="nfh-contact-row" href="mailto:help@labacinema.online">
          <div class="nfh-contact-left">
            <span class="nfh-contact-logo" data-brand="email" aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="M3 7l9 6 9-6"></path>
              </svg>
            </span>
            <span class="nfh-contact-value">help@labacinema.online</span>
          </div>
          <span class="nfh-contact-arrow">→</span>
        </a>
      </div>
    </section>

    <!-- Report -->
    <section class="nfh-section" id="report">
      <h2 class="nfh-section-title">Report an issue</h2>
      <p class="nfh-lede">Broken video, wrong info, or a bug? Tell us and we'll fix it fast.</p>

      <form class="nfh-report" action="#" method="post">
        <label class="nfh-field">
          <span>Movie or page URL</span>
          <input type="text" name="url" placeholder="/play/inception or a full URL">
        </label>
        <label class="nfh-field">
          <span>What's wrong?</span>
          <textarea name="issue" rows="4" placeholder="Describe the issue..."></textarea>
        </label>
        <button type="submit" class="nfh-submit">Submit report</button>
      </form>
    </section>
  </main>

  <%- include('../shared/footer', { brand: brand }) %>
</body>
</html>
