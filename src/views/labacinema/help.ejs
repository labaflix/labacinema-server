<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Help Center - <%= brand.name %><%= brand.suffix %></title>
  <link rel="stylesheet" href="/css/labacinema.css">
  <%- include('../shared/head-meta') %>
</head>
<body>
  <%- include('../shared/nav', { brand: brand, query: '', active: 'help' }) %>

  <main class="nfh">
    <!-- Hero -->
    <section class="nfh-hero">
      <h1 class="nfh-hero-title">How can we help?</h1>
      <form class="nfh-search" action="/help" method="get">
        <svg class="nfh-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" name="q" placeholder="Search help articles" autocomplete="off">
      </form>
    </section>

    <!-- Quick topic tiles -->
    <section class="nfh-topics">
      <a href="#faq" class="nfh-topic">
        <div class="nfh-topic-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7v.5"></path>
            <circle cx="12" cy="17" r=".6" fill="currentColor" stroke="none"></circle>
          </svg>
        </div>
        <div class="nfh-topic-body">
          <h3>FAQs</h3>
          <p>Common questions answered</p>
        </div>
      </a>
      <a href="#guides" class="nfh-topic">
        <div class="nfh-topic-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h12a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3V4z"></path>
            <path d="M4 17a3 3 0 0 1 3-3h12"></path>
          </svg>
        </div>
        <div class="nfh-topic-body">
          <h3>Guides</h3>
          <p>How to watch and download</p>
        </div>
      </a>
      <a href="#contact" class="nfh-topic">
        <div class="nfh-topic-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <div class="nfh-topic-body">
          <h3>Contact us</h3>
          <p>Talk to our team</p>
        </div>
      </a>
      <a href="#report" class="nfh-topic">
        <div class="nfh-topic-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 3 7v6c0 5 4 8 9 9 5-1 9-4 9-9V7l-9-5z"></path>
            <line x1="12" y1="8" x2="12" y2="13"></line>
            <circle cx="12" cy="16.5" r=".6" fill="currentColor" stroke="none"></circle>
          </svg>
        </div>
        <div class="nfh-topic-body">
          <h3>Report an issue</h3>
          <p>Broken video or bug</p>
        </div>
      </a>
    </section>

    <!-- FAQ section -->
    <section class="nfh-section" id="faq">
      <h2 class="nfh-section-title">Frequently asked questions</h2>

      <details class="nfh-faq" open>
        <summary>Is LabaCinema really free?</summary>
        <div class="nfh-faq-body">
          <p>Yes. Every movie on LabaCinema is completely free to stream and download. No signup, no payment, no hidden fees. Just click and watch.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>Do I need to create an account?</summary>
        <div class="nfh-faq-body">
          <p>No account is required for LabaCinema. You can browse, watch and download without signing in. The upcoming paid LabaFlix experience will require login.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>How do I download a movie?</summary>
        <div class="nfh-faq-body">
          <p>Open any movie page, then click the <strong>Download</strong> button under the player. Your browser saves the MP4 directly. Downloads are free and unlimited.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>The video won't play. What should I do?</summary>
        <div class="nfh-faq-body">
          <p>Try these in order:</p>
          <ol style="margin:8px 0 0;padding-left:20px;color:var(--netflix-light)">
            <li>Refresh the page</li>
            <li>Try a different browser (Chrome, Safari, Firefox)</li>
            <li>Check your internet connection</li>
            <li>Clear your browser cache</li>
          </ol>
          <p style="margin-top:8px">If it still fails, <a href="#report">report the issue</a>.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>Can I watch on my phone?</summary>
        <div class="nfh-faq-body">
          <p>Yes. The site is fully mobile-friendly. Open it in Chrome (Android) or Safari (iOS), rotate to landscape for the best view, and tap any movie to play.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>How do I request a movie?</summary>
        <div class="nfh-faq-body">
          <p>Use the <a href="/requests">Movie Requests</a> page, or send us the title directly on <a href="#contact">WhatsApp or Telegram</a>. We add new movies weekly.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>What is LabaFlix?</summary>
        <div class="nfh-faq-body">
          <p>LabaFlix is our upcoming premium service at <strong>labaflix.com</strong>. It will include login, watchlist, history, kids mode (LabaTOTO) and downloads for paid members. LabaCinema will stay free forever.</p>
        </div>
      </details>

      <details class="nfh-faq">
        <summary>Is my data safe?</summary>
        <div class="nfh-faq-body">
          <p>LabaCinema does not require an account and does not track you. We do not store personal data beyond basic server logs used for reliability.</p>
        </div>
      </details>
    </section>

    <!-- Guides -->
    <section class="nfh-section" id="guides">
      <h2 class="nfh-section-title">How-to guides</h2>

      <div class="nfh-guides">
        <article class="nfh-guide">
          <h3>Watch a movie</h3>
          <ol>
            <li>Find a movie from the Home or Movies page</li>
            <li>Click the poster</li>
            <li>Press Play</li>
          </ol>
        </article>
        <article class="nfh-guide">
          <h3>Download a movie</h3>
          <ol>
            <li>Open the movie page</li>
            <li>Click Download</li>
            <li>The MP4 saves to your Downloads folder</li>
          </ol>
        </article>
        <article class="nfh-guide">
          <h3>Search movies</h3>
          <ol>
            <li>Click the search icon in the nav</li>
            <li>Type the title</li>
            <li>Press Enter or click Search</li>
          </ol>
        </article>
        <article class="nfh-guide">
          <h3>Watch on mobile</h3>
          <ol>
            <li>Open labacinema.online in your browser</li>
            <li>Rotate to landscape</li>
            <li>Tap Play on any movie</li>
          </ol>
        </article>
      </div>
    </section>

    <!-- Contact -->
    <section class="nfh-section" id="contact">
      <h2 class="nfh-section-title">Contact us</h2>
      <p class="nfh-lede">We reply within 24 hours. Reach us on any channel below.</p>

            <div class="nfh-contact-list">
        <a class="nfh-contact-row" href="https://wa.me/256702430965" target="_blank" rel="noopener">
          <div class="nfh-contact-left">
            <span class="nfh-contact-logo" data-brand="whatsapp" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
