<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Contact Us - <%= brand.name %><%= brand.suffix %></title>
  <link rel="stylesheet" href="/css/labacinema.css">
  <%- include('../shared/head-meta') %>
</head>
<body>
  <%- include('../shared/nav', { brand: brand, query: '', active: '' }) %>

  <main class="nfc">
