          </svg>
        </span>
        <div class="nfc-body">
          <div class="nfc-label">WhatsApp</div>
          <div class="nfc-value">0702430965</div>
        </div>
        <span class="nfc-arrow">→</span>
      </a>

      <a class="nfc-row" href="https://t.me/labacinema" target="_blank" rel="noopener">
        <span class="nfc-icon" data-brand="telegram" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/>
          </svg>
        </span>
        <div class="nfc-body">
          <div class="nfc-label">Telegram</div>
          <div class="nfc-value">@labacinema</div>
        </div>
        <span class="nfc-arrow">→</span>
      </a>

      <a class="nfc-row" href="mailto:help@labacinema.online">
        <span class="nfc-icon" data-brand="email" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
