    <section class="nfc-info">
      <h2>We're here to help</h2>
      <ul>
        <li><strong>Quick response:</strong> We typically reply within 24 hours during business days.</li>
        <li><strong>Support hours:</strong> Monday – Saturday, 9:00 AM – 6:00 PM (EAT).</li>
        <li><strong>For account issues:</strong> Please include your registered email or phone number.</li>
      </ul>
    </section>

    <a href="/" class="nfc-back">&larr; Back to Home</a>
  </main>

  <%- include('../shared/footer', { brand: brand }) %>
