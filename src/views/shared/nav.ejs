    <a href="/explore" class="<%= typeof active !== 'undefined' && active === 'explore' ? 'active' : '' %>">Explore</a>
    <a href="/movies" class="<%= typeof active !== 'undefined' && active === 'movies' ? 'active' : '' %>">Movies</a>
    <a href="/series" class="<%= typeof active !== 'undefined' && active === 'series' ? 'active' : '' %>">Series</a>
    <a href="/categories" class="<%= typeof active !== 'undefined' && active === 'categories' ? 'active' : '' %>">Categories &amp; VJs</a>
    <a href="/watchlist" class="<%= typeof active !== 'undefined' && active === 'watchlist' ? 'active' : '' %>">Watchlist</a>
    <a href="/history" class="<%= typeof active !== 'undefined' && active === 'history' ? 'active' : '' %>">Watch History</a>
    <a href="/requests" class="<%= typeof active !== 'undefined' && active === 'requests' ? 'active' : '' %>">Movie Requests</a>
    <a href="/help" class="<%= typeof active !== 'undefined' && active === 'help' ? 'active' : '' %>">Help</a>
